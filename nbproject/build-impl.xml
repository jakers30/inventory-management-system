<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal Ant build for the project. It follows the NetBeans property names
  (src.dir, build.classes.dir, dist.jar, main.class) so the targets stay the
  same when the project is opened in NetBeans.
-->
<project name="InventoryManagementSystem-impl" default="default" basedir="..">
    <property file="nbproject/project.properties"/>

    <target name="-init">
        <mkdir dir="${build.classes.dir}"/>
    </target>

    <target name="compile" depends="-init" description="Compile every source file into build/classes.">
        <javac srcdir="${src.dir}"
               destdir="${build.classes.dir}"
               source="${javac.source}"
               target="${javac.target}"
               encoding="${source.encoding}"
               debug="true"
               includeantruntime="false">
            <classpath/>
        </javac>
    </target>

    <target name="run" depends="compile" description="Run the application.">
        <java classname="${main.class}" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${build.classes.dir}"/>
            </classpath>
        </java>
    </target>

    <target name="jar" depends="compile" description="Package the classes into dist/InventoryManagementSystem.jar.">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}" compress="${jar.compress}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
            </manifest>
        </jar>
    </target>

    <target name="clean" description="Delete the build and dist folders.">
        <delete dir="${build.dir}" quiet="true"/>
        <delete dir="${dist.dir}" quiet="true"/>
    </target>

    <target name="default" depends="compile" description="Build the project."/>
</project>
